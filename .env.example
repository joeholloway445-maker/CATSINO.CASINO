# Periliminal.Space — environment configuration example.
#
# Copy to .env and fill in real values before running docker compose:
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored.

# ── Supabase ────────────────────────────────────────────────────────────────
# Create a project at supabase.com → Settings → API.
# The service key bypasses RLS (used server-side only — never exposed to clients).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Nakama game server ───────────────────────────────────────────────────────
# Secret key shared between the Nakama server and all clients.
# Must match --socket.server_key in the nakama service command.
NAKAMA_SERVER_KEY=defaultkey

# ── AI keys ─────────────────────────────────────────────────────────────────
# Anthropic key — powers the HOPE companion and HDV Core's AI features.
# Get yours at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini key — powers the Google Drive Cleaner AI triage feature.
# Get yours at aistudio.google.com/app/apikey (free tier available).
GEMINI_API_KEY=AIza...

# Google OAuth client ID — powers the Google Drive Cleaner login.
# Create credentials at console.cloud.google.com → APIs & Services → Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Domain names (production) ────────────────────────────────────────────────
# The nginx proxy routes three domains to the three web services.
# Use localhost for local dev (nginx proxy not required locally).
CATSINO_DOMAIN=catsino.casino
HDV_DOMAIN=periliminal.space
PLAY_DOMAIN=play.catsino.casino

# ── Psychology service (optional tuning) ─────────────────────────────────────
# How often the LangGraph psychology engine polls for new telemetry (seconds).
# Lower values give faster axis updates; higher values reduce DB load.
PSYCH_POLL_INTERVAL=60
