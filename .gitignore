# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Godot local cache / import db (never commit)
godot/.godot/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated asset job manifests (scripts/export_asset_prompts.py) and
# Godot export builds (generated locally or in CI) — same directory name,
# both purposes
build/
builds/

# Python bytecode from the fetch/export scripts
__pycache__/
*.pyc

# Godot runtime server config — contains Nakama server key, never commit
godot/server_config.json

# nginx TLS certs (managed by certbot on VPS)
nginx/certs/

# Non-redistributable personal downloads (RenderPeople, TurboSquid RF, etc.)
godot/assets/private/**
!godot/assets/private/README.md
